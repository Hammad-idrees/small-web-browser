{
  "name": "small-web-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:contracts && concurrently --names contracts,api,web --prefix-colors gray,blue,green \"pnpm --filter @small-web/contracts dev\" \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm build:contracts && pnpm --filter api build && pnpm --filter web build",
    "build:contracts": "pnpm --filter @small-web/contracts build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm build:contracts && pnpm -r --if-present typecheck",
    "test": "pnpm build:contracts && pnpm -r --if-present test",
    "test:e2e": "pnpm build:contracts && pnpm --filter api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
